# Keep the Docker image small: only the code, input data, the paper parameter
# file and the paper results are needed at runtime.

.git/
.gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
.mplconfig/
.ipynb_checkpoints/

# Superseded development builds (not used by the app)
archive/

# Logs and scratch
*.log
